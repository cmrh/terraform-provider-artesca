# ARTESCA Integration Test Configuration
# Copy to ~/.scality-artesca.env and fill in real values.
# Used by: tests/integration/run.sh

# Test framework
export TF_ACC_TERRAFORM_PATH="/usr/bin/tofu"
export TF_ACC_PROVIDER_NAMESPACE="scality"

# Provider configuration (read by the provider via env vars)
export ARTESCA_MANAGEMENT_ENDPOINT="https://management.artesca.example.com"
export ARTESCA_INSECURE_SKIP_VERIFY="true"
export ARTESCA_OIDC_URL="https://oidc.artesca.example.com"
export ARTESCA_USERNAME=""
export ARTESCA_PASSWORD=""
export ARTESCA_S3_ENDPOINT="https://s3.artesca.example.com"
